rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ---------------------------------------------------------------
    // users — doc ID = uid
    //   - cualquiera autenticado puede leer la lista (la app muestra
    //     vendedores/roles en varias pantallas)
    //   - solo admin gestiona usuarios ajenos
    //   - cada usuario puede leer/editar su propio perfil,
    //     pero NUNCA cambiarse el rol a sí mismo (anti auto-promoción)
    //   - el usuario puede borrar su propia cuenta (flujo de perfil)
    //   - al CREAR usuario, la app primero hace signUp (Firebase cambia
    //     la sesión al usuario nuevo) y luego escribe el doc: por eso se
    //     permite self-create solo con rol 'vendedor'.
    //     NOTA: crear otro admin desde la app requerirá Cloud Functions
    //     o hacerlo desde la consola de Firebase.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'vendedor'
        && request.resource.data.uid == userId;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
    }

    // ---------------------------------------------------------------
    // products — inventario compartido del equipo
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    // ---------------------------------------------------------------
    // cart — carrito de venta compartido (mostrador)
    // ---------------------------------------------------------------
    match /cart/{cartItemId} {
      allow read, write: if isSignedIn();
    }

    // ---------------------------------------------------------------
    // ventas — historial de ventas
    // ---------------------------------------------------------------
    match /ventas/{ventaId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn(); // borrar venta está disponible en la UI de ventas
    }

    // ---------------------------------------------------------------
    // providers — proveedores
    // ---------------------------------------------------------------
    match /providers/{providerId} {
      allow read, write: if isSignedIn();
    }

    // ---------------------------------------------------------------
    // banner — personalización de perfil (fondo, color, posición)
    // ---------------------------------------------------------------
    match /banner/{bannerId} {
      allow read, write: if isSignedIn();
    }

    // ---------------------------------------------------------------
    // metadata/counters — contador interno de productos
    // ---------------------------------------------------------------
    match /metadata/{docId} {
      allow read, write: if isSignedIn();
    }

    // ---------------------------------------------------------------
    // config/stockAlert — umbral de stock bajo
    //   - leer: cualquier usuario autenticado (alertas en varias vistas)
    //   - escribir: solo admin (pantalla de ajustes)
    // ---------------------------------------------------------------
    match /config/stockAlert {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // gastos — financiero, solo admin (rutas protegidas por AdminGuard)
    // ---------------------------------------------------------------
    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // appointments — solo admin (rutas protegidas por AdminGuard)
    // ---------------------------------------------------------------
    match /appointments/{appointmentId} {
      allow read, write: if isAdmin();
    }

    // Cualquier otra colección: denegado por defecto.
  }
}
